<Application x:Class="OverTranslate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default theme loaded first; ThemeService swaps it on startup if Dark is saved -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/SharedStyles.xaml"/>
                <!-- No strings here: LocalizationService.Apply adds the user's language on startup,
                     before any window, and swaps it whenever the language changes. Listing a
                     default here only had it read and thrown away on every start. -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
