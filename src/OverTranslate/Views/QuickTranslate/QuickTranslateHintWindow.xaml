<Window x:Class="OverTranslate.Views.QuickTranslate.QuickTranslateHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <!-- The same small label as 取詞翻譯's 簡單顯示 (SelectionLabelWindow): text and nothing else.
         The margin is room for the shadow; short of the blur radius it is cut off by the window's
         edge. -->
    <Border Margin="8,6,8,10">
        <Border x:Name="Card"
                Background="{DynamicResource HintCardBg}"
                BorderBrush="{DynamicResource HintCardBorder}"
                BorderThickness="1"
                CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                  Opacity="0.18" Color="#000000"/>
            </Border.Effect>
            <TextBlock x:Name="MessageText"
                       MaxWidth="400"
                       MaxHeight="80"
                       Margin="8,4,8,5"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource AppTextPrimary}"/>
        </Border>
    </Border>
</Window>
