<Window x:Class="OverTranslate.Views.Capture.AnnotationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- 文字's small square switches: B, I, U, S and the size field's chevron. Flat until hovered,
             and checked the way the tool buttons are — the accent plate and edge — so "on" reads the
             same everywhere on the panel. -->
        <Style x:Key="TextOptionToggle" TargetType="ToggleButton">
            <Setter Property="Foreground"  Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width"       Value="30"/>
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Focusable"   Value="False"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"  Value="{DynamicResource AppAccentSubtle}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The letters on B I U S: a serif, because those four are the convention every editor shows
             them in, and in the interface's own face an I is a bare stroke. -->
        <Style x:Key="TextOptionGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia, Times New Roman"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
        </Style>

        <!-- A size in the tray under the field. -->
        <Style x:Key="TextSizeChoice" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="MinWidth"   Value="40"/>
            <Setter Property="Height"     Value="28"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="7" Padding="6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The same margin the capture toolbar leaves, and for the same reason: a blur still carrying
         opacity at the window's edge is cut off by a straight line, which reads as a stray border
         around the bar. -->
    <Border Margin="12,10,12,14">
        <!-- The bar, and the 形狀 tray hung off it. A stack rather than one surface so the tray can
             come and go without the bar itself changing shape, and so it can be put on whichever
             side of the bar faces away from the capture toolbar — see ShowShapeTray. -->
        <StackPanel x:Name="PanelStack">
            <Grid x:Name="PanelBar">
                <!-- Shadow on an empty twin rather than on the bar: an Effect rasterises the element
                     it is set on, and ClearType cannot run over a surface that may be transparent —
                     which at 11px CJK is the difference between a label that reads and one that
                     looks thin. Same trick the capture toolbar uses, for the same reason. -->
                <Border Background="{DynamicResource ToolbarBg}"
                        Margin="2"
                        CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                          Opacity="0.20" Color="#000000"/>
                    </Border.Effect>
                </Border>

                <!-- Named because the window is bigger than the bar: the margin above holds the
                     shadow, so where this panel sits relative to the toolbar has to be measured from
                     the surface the user can see, not from the window's edge. See PlaceNear. -->
                <Border x:Name="PanelSurface"
                        Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource ToolbarBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8,8"
                        RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- What a drag inside the box does. Three states of one control, so they are
                             one radio group: picking a tool is picking, not switching three things on
                             and off. -->
                        <ToggleButton x:Name="PenTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- The same pen the 標記 button on the bar above wears, to the
                                         point. The panel is that button opened up, and the tool it
                                         defaults to had better be the thing the button showed. -->
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.5,16.3 L3,11.85 L10.9,1.35 L14.55,4.1 L6.65,14.55 Z"/>
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M3,11.85 L6.65,14.55"/>
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.5,16.3 H15.5"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Pen}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="HighlighterTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- Head-on and standing upright, not the pen tilted and fattened.
                                         A highlighter is held square to the page and its whole
                                         character is the chisel across the bottom, which is a shape
                                         you can only see from the front — turned to the same angle as
                                         the pen it becomes the pen with a thick line under it, and
                                         the two tools stop being distinguishable at 18px.

                                         Barrel, then the shoulders tapering to the felt, then a
                                         window across the taper. -->
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M4.4,0.8 H13.6 A1.3,1.3 0 0 1 14.9,2.1 V7 L11.3,12.6
                                                H6.7 L3.1,7 V2.1 A1.3,1.3 0 0 1 4.4,0.8 Z"/>
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M7.2,9 H10.8"/>

                                    <!-- The felt and the band it has just laid down, in the one colour
                                         that names this tool without a label. Fixed rather than the
                                         colour currently in hand: the icon says which tool this is,
                                         and a tool whose picture changed with the palette would be a
                                         different picture every time the user looked for it. -->
                                    <Path Fill="{DynamicResource ToolbarHighlighterInk}"
                                          Stroke="{DynamicResource ToolbarHighlighterInk}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          Data="M6.7,12.6 L7.5,14.6 H10.5 L11.3,12.6 Z"/>
                                    <Path Stroke="{DynamicResource ToolbarHighlighterInk}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Flat"
                                          StrokeEndLineCap="Flat"
                                          Data="M1.7,16.5 H16.3"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Highlighter}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- 形狀: the four drag-out shapes behind one button, which wears whichever
                             of them is in hand (or was last) so the button says what a press will
                             give. The chevron is what says there is a choice behind it. -->
                        <ToggleButton x:Name="ShapeTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ShapeTool_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path x:Name="ShapeIconLine"
                                          Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.6,15.4 L15.4,2.6"/>
                                    <Path x:Name="ShapeIconArrow"
                                          Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.6,15.4 L15.4,2.6 M8.7,4.6 L15.4,2.6 L13.4,9.3"/>
                                    <Path x:Name="ShapeIconRectangle"
                                          Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.2,3.8 H15.8 V14.2 H2.2 Z"/>
                                    <Path x:Name="ShapeIconEllipse"
                                          Style="{StaticResource ToolbarToolStroke}"
                                          Data="M1.8,9 A7.2,5.6 0 1 1 16.2,9 A7.2,5.6 0 1 1 1.8,9 Z"/>
                                  </Grid>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ShapeLabel"/>
                                    <Path x:Name="ShapeChevron"
                                          Style="{StaticResource ToolbarToolStroke}"
                                          StrokeThickness="1.2"
                                          Margin="3,1,0,0"
                                          VerticalAlignment="Center"
                                          Data="M0,0 L3,3 L6,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ToggleButton>

                        <!-- 文字 (#362): a click puts a box where the words will go. Its own button
                             rather than a fifth thing behind 形狀 — it is typed, not dragged out, and
                             it brings its own controls with it. -->
                        <ToggleButton x:Name="TextTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M3,4.4 V2.6 H15 V4.4 M9,2.6 V15.4 M6.4,15.4 H11.6"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Text}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- 馬賽克 and 模糊: a box dragged out over something that must not be read,
                             reworked from the capture under it. -->
                        <ToggleButton x:Name="MosaicTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.2,2.2 H15.8 V15.8 H2.2 Z"/>
                                    <Path Fill="{DynamicResource ToolbarHighlighterInk}"
                                          Data="M2.2,2.2 H6.7 V6.7 H2.2 Z M11.3,2.2 H15.8 V6.7 H11.3 Z M6.7,6.7 H11.3 V11.3 H6.7 Z
                                                M2.2,11.3 H6.7 V15.8 H2.2 Z M11.3,11.3 H15.8 V15.8 H11.3 Z"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Mosaic}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="BlurTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- A drop, soft-edged: three rings fading out. -->
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M9,1.8 C9,1.8 3.6,8 3.6,11.2 A5.4,5.4 0 0 0 14.4,11.2 C14.4,8 9,1.8 9,1.8 Z"/>
                                    <Path Style="{StaticResource ToolbarToolStroke}" Opacity="0.55"
                                          Data="M6.4,11.4 A2.6,2.6 0 0 0 9,14"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Blur}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- 序號: a numbered disc per click, 1, 2, 3... -->
                        <ToggleButton x:Name="NumberTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M1.8,9 A7.2,7.2 0 1 1 16.2,9 A7.2,7.2 0 1 1 1.8,9 Z"/>
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M7.4,6.4 L9.4,4.9 V13.1 M7.4,13.1 H11.2"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Number}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="EraserTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- A block tipped onto its corner and cut off flat where it meets
                                         the surface, with the crease between the rubber and its sleeve
                                         running across it. The flat cut and the line it rests on are
                                         the whole idea: an eraser is the one tool here that is pushed
                                         against something, and a block floating free is just a
                                         rhombus. -->
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M1.15,11.35 L10.05,2.4 A1.5,1.5 0 0 1 12.15,2.4
                                                L15.85,6.05 A1.5,1.5 0 0 1 15.85,8.15 L7.6,16.4 H6.15 Z"/>
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M4.25,8.9 L9.3,14"/>
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M6.15,16.4 H16.6"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Eraser}"/>
                            </StackPanel>
                        </ToggleButton>

                        <Button x:Name="UndoBtn"
                                Style="{StaticResource ToolbarStackButton}"
                                Click="UndoBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M7,2.6 L2.6,7 L7,11.4 M2.6,7 H11 A4.4,4.4 0 0 1 11,15.8 H4.3"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Undo}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RedoBtn"
                                Style="{StaticResource ToolbarStackButton}"
                                Click="RedoBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- 復原 mirrored about the middle of the canvas, arc sweep and
                                         all. Two arrows that are not each other's reflection is the
                                         sort of thing nobody can name and everybody sees. -->
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M11,2.6 L15.4,7 L11,11.4 M15.4,7 H7 A4.4,4.4 0 0 0 7,15.8 H13.7"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Redo}"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1"
                                   Margin="14,9,10,9"
                                   Fill="{DynamicResource ToolbarDivider}"/>

                        <!-- Filled from code so the palette is one list in one place rather than
                             eight near-identical blocks of markup — see BuildPalette. -->
                        <StackPanel x:Name="Palette"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"/>

                        <Rectangle Width="1"
                                   Margin="12,9,12,9"
                                   Fill="{DynamicResource ToolbarDivider}"/>

                        <!-- Named above, and its two ends named underneath. The name alone says what
                             is being adjusted but not which way, so the user has to move the thing
                             to find out — and on a control whose entire answer is a position, that
                             is worth two characters. No number beside it, deliberately: what the
                             user is choosing is how the mark looks against what is underneath it,
                             and there is no number that answers that. They can see the stroke.

                             One slider for all three tools, mapped onto each one's own range — see
                             RangeFor. A slider per tool would be three controls the user has to
                             discover are three, on a panel whose whole point is that it is small. -->
                        <!-- The three labels are filled from code rather than bound, because the
                             eraser renames them: what it has is not a stroke width but a reach, so
                             it reads 大小 / 小 / 大 while the two pens read 粗細 / 細 / 粗. Same
                             control, same position, same value — a second slider that appeared in
                             its place would be a different control in the same spot. -->
                        <StackPanel x:Name="ThicknessBlock" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock x:Name="ThicknessTitle"
                                       Style="{StaticResource AnnotationSliderTitle}"/>
                            <Slider x:Name="ThicknessSlider"
                                    Style="{StaticResource AnnotationSlider}"
                                    ValueChanged="ThicknessSlider_ValueChanged"
                                    PreviewMouseDoubleClick="Slider_PreviewMouseDoubleClick"/>
                            <Grid>
                                <TextBlock x:Name="ThicknessMinLabel"
                                           HorizontalAlignment="Left"
                                           Style="{StaticResource AnnotationSliderEnd}"/>
                                <TextBlock x:Name="ThicknessMaxLabel"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource AnnotationSliderEnd}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 文字's size, in the slider's place: words are measured in pixels the user
                             can type, not a width chosen by eye. The number is typed straight into
                             the field, or picked from the tray the chevron opens. No name over it,
                             unlike the sliders: a number in px already says what it is, and the
                             title only pushed the field off the row's centre line. -->
                        <StackPanel x:Name="TextSizeBlock"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Visibility="Collapsed">
                            <Border x:Name="TextSizeFrame"
                                    Height="30"
                                    CornerRadius="7"
                                    BorderThickness="1"
                                    Background="{DynamicResource AppButtonBg}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorder}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppInputFocusBorder}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <ToggleButton x:Name="TextSizeDrop"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource TextOptionToggle}"
                                                  Width="26"
                                                  Height="28"
                                                  Click="TextSizeDrop_Click">
                                        <Path Style="{StaticResource ToolbarToolStroke}"
                                              StrokeThickness="1.2"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              Data="M0,0 L3,3 L6,0"/>
                                    </ToggleButton>
                                    <TextBlock Text="px"
                                               DockPanel.Dock="Right"
                                               Margin="2,0,2,1"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource AppTextSecondary}"/>
                                    <TextBox x:Name="TextSizeBox"
                                             Width="34"
                                             Margin="6,0,0,0"
                                             VerticalAlignment="Center"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             HorizontalContentAlignment="Right"
                                             FontFamily="{DynamicResource AppFont}"
                                             FontSize="13"
                                             Foreground="{DynamicResource AppTextPrimary}"
                                             CaretBrush="{DynamicResource AppTextPrimary}"
                                             SelectionBrush="{DynamicResource AppAccent}"
                                             MaxLength="3"
                                             InputMethod.IsInputMethodEnabled="False"
                                             AutomationProperties.Name="{DynamicResource S.Annotate.Size}"
                                             PreviewMouseLeftButtonDown="TypingBox_PreviewMouseLeftButtonDown"
                                             PreviewTextInput="TextSizeBox_PreviewTextInput"
                                             PreviewKeyDown="TextSizeBox_PreviewKeyDown"
                                             GotKeyboardFocus="TextSizeBox_GotKeyboardFocus"
                                             LostKeyboardFocus="TextSizeBox_LostKeyboardFocus"
                                             MouseWheel="TextSizeBox_MouseWheel"
                                             DataObject.Pasting="TextSizeBox_Pasting"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- B I U S, for the whole of the words rather than a selection in them: a
                             note on a screenshot is set one way, and per-character styling would make
                             the box a document editor. Shown only with 文字 in hand, like 透明度. -->
                        <Rectangle x:Name="TextStyleDivider"
                                   Width="1"
                                   Margin="12,6,12,6"
                                   Fill="{DynamicResource ToolbarDivider}"
                                   Visibility="Collapsed"/>

                        <StackPanel x:Name="TextStyleBlock"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Visibility="Collapsed">
                            <ToggleButton x:Name="BoldToggle"
                                          Style="{StaticResource TextOptionToggle}"
                                          ToolTip="{DynamicResource S.Annotate.Bold}"
                                          AutomationProperties.Name="{DynamicResource S.Annotate.Bold}"
                                          Click="TextStyleToggle_Click">
                                <TextBlock Style="{StaticResource TextOptionGlyph}" Text="B" FontWeight="Bold"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ItalicToggle"
                                          Margin="2,0,0,0"
                                          Style="{StaticResource TextOptionToggle}"
                                          ToolTip="{DynamicResource S.Annotate.Italic}"
                                          AutomationProperties.Name="{DynamicResource S.Annotate.Italic}"
                                          Click="TextStyleToggle_Click">
                                <TextBlock Style="{StaticResource TextOptionGlyph}" Text="I" FontStyle="Italic"/>
                            </ToggleButton>
                            <ToggleButton x:Name="UnderlineToggle"
                                          Margin="2,0,0,0"
                                          Style="{StaticResource TextOptionToggle}"
                                          ToolTip="{DynamicResource S.Annotate.Underline}"
                                          AutomationProperties.Name="{DynamicResource S.Annotate.Underline}"
                                          Click="TextStyleToggle_Click">
                                <TextBlock Style="{StaticResource TextOptionGlyph}" Text="U" TextDecorations="Underline"/>
                            </ToggleButton>
                            <ToggleButton x:Name="StrikethroughToggle"
                                          Margin="2,0,0,0"
                                          Style="{StaticResource TextOptionToggle}"
                                          ToolTip="{DynamicResource S.Annotate.Strikethrough}"
                                          AutomationProperties.Name="{DynamicResource S.Annotate.Strikethrough}"
                                          Click="TextStyleToggle_Click">
                                <TextBlock Style="{StaticResource TextOptionGlyph}" Text="S" TextDecorations="Strikethrough"/>
                            </ToggleButton>

                            <!-- 描邊: an outline round each glyph, so the words read on any ground.
                                 Its colour and reach show only while it is on. -->
                            <ToggleButton x:Name="OutlineToggle"
                                          Margin="2,0,0,0"
                                          Style="{StaticResource TextOptionToggle}"
                                          ToolTip="{DynamicResource S.Annotate.Outline}"
                                          AutomationProperties.Name="{DynamicResource S.Annotate.Outline}"
                                          Click="OutlineToggle_Click">
                                <Path Style="{StaticResource ToolbarToolStroke}"
                                      StrokeThickness="1.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      Data="M8,1.5 L14.5,15 H11.4 L10.2,12.2 H5.8 L4.6,15 H1.5 Z M6.9,9.6 H9.1 L8,6.8 Z"/>
                            </ToggleButton>

                            <StackPanel x:Name="OutlineOptions"
                                        Orientation="Horizontal"
                                        Margin="4,0,0,0"
                                        Visibility="Collapsed">
                                <ToggleButton x:Name="OutlineColorButton"
                                              Style="{StaticResource TextOptionToggle}"
                                              ToolTip="{DynamicResource S.Annotate.OutlineColor}"
                                              AutomationProperties.Name="{DynamicResource S.Annotate.OutlineColor}"
                                              Click="OutlineColorButton_Click">
                                    <Border x:Name="OutlineColorChip"
                                            Width="16"
                                            Height="16"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AppButtonBorder}"/>
                                </ToggleButton>

                                <Border Height="30"
                                        Margin="4,0,0,0"
                                        CornerRadius="7"
                                        BorderThickness="1"
                                        Background="{DynamicResource AppButtonBg}"
                                        ToolTip="{DynamicResource S.Annotate.OutlineWidth}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorder}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppInputFocusBorder}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock Text="px"
                                                   DockPanel.Dock="Right"
                                                   Margin="2,0,6,1"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource AppFont}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource AppTextSecondary}"/>
                                        <TextBox x:Name="OutlineWidthBox"
                                                 Width="20"
                                                 Margin="6,0,0,0"
                                                 VerticalAlignment="Center"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0"
                                                 HorizontalContentAlignment="Right"
                                                 FontFamily="{DynamicResource AppFont}"
                                                 FontSize="13"
                                                 Foreground="{DynamicResource AppTextPrimary}"
                                                 CaretBrush="{DynamicResource AppTextPrimary}"
                                                 SelectionBrush="{DynamicResource AppAccent}"
                                                 MaxLength="2"
                                                 InputMethod.IsInputMethodEnabled="False"
                                                 AutomationProperties.Name="{DynamicResource S.Annotate.OutlineWidth}"
                                                 PreviewMouseLeftButtonDown="TypingBox_PreviewMouseLeftButtonDown"
                                                 PreviewTextInput="TextSizeBox_PreviewTextInput"
                                                 PreviewKeyDown="OutlineWidthBox_PreviewKeyDown"
                                                 GotKeyboardFocus="TextSizeBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="OutlineWidthBox_LostKeyboardFocus"
                                                 MouseWheel="OutlineWidthBox_MouseWheel"
                                                 DataObject.Pasting="TextSizeBox_Pasting"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- How much of the page still shows through, for the one tool the question
                             applies to. Shown only in 螢光筆 mode rather than greyed out beside the
                             pen: a highlighter's whole character is that it is see-through, so this
                             is not an extra setting the tool happens to have — it is half of what
                             the tool is, and it belongs on screen exactly when the tool is. -->
                        <Rectangle x:Name="OpacityDivider"
                                   Width="1"
                                   Margin="12,6,12,6"
                                   Fill="{DynamicResource ToolbarDivider}"/>

                        <StackPanel x:Name="OpacityBlock" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource S.Annotate.Opacity}"
                                       Style="{StaticResource AnnotationSliderTitle}"/>
                            <Slider x:Name="OpacitySlider"
                                    Style="{StaticResource AnnotationSlider}"
                                    AutomationProperties.Name="{DynamicResource S.Annotate.Opacity}"
                                    ValueChanged="OpacitySlider_ValueChanged"
                                    PreviewMouseDoubleClick="Slider_PreviewMouseDoubleClick"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Faint}"
                                           HorizontalAlignment="Left"
                                           Style="{StaticResource AnnotationSliderEnd}"/>
                                <TextBlock Text="{DynamicResource S.Annotate.Strong}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource AnnotationSliderEnd}"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- The three shapes behind the 形狀 button, opened under it. Part of this window rather
                 than a Popup: a Popup only closes itself on an outside click by capturing the mouse,
                 and in a window that never activates that capture is not reliably let go. Here it
                 closes on the three things that end the choice — picking a shape, pressing 形狀
                 again, or picking up another tool. -->
            <Grid x:Name="ShapeTray"
                  HorizontalAlignment="Left"
                  Visibility="Collapsed">
                <Border Background="{DynamicResource ToolbarBg}"
                        Margin="2"
                        CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                          Opacity="0.20" Color="#000000"/>
                    </Border.Effect>
                </Border>

                <Border x:Name="ShapeTraySurface"
                        Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource ToolbarBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="6"
                        RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="LineTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ShapeChoice_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.6,15.4 L15.4,2.6"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Line}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="ArrowTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ShapeChoice_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.6,15.4 L15.4,2.6 M8.7,4.6 L15.4,2.6 L13.4,9.3"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Arrow}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="RectangleTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ShapeChoice_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M2.2,3.8 H15.8 V14.2 H2.2 Z"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Rectangle}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="EllipseTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ShapeChoice_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarToolStroke}"
                                          Data="M1.8,9 A7.2,5.6 0 1 1 16.2,9 A7.2,5.6 0 1 1 1.8,9 Z"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Ellipse}"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The sizes behind the 文字 size field's chevron, hung off the bar the same way the
                 shapes are behind 形狀. Filled from code — see BuildTextSizeTray. -->
            <Grid x:Name="TextSizeTray"
                  HorizontalAlignment="Left"
                  Visibility="Collapsed">
                <Border Background="{DynamicResource ToolbarBg}"
                        Margin="2"
                        CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                          Opacity="0.20" Color="#000000"/>
                    </Border.Effect>
                </Border>

                <Border x:Name="TextSizeTraySurface"
                        Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource ToolbarBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="6"
                        RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel x:Name="TextSizeChoices" Orientation="Horizontal"/>
                </Border>
            </Grid>

            <!-- The 描邊 colours, behind the colour chip: the same eight the ink is picked from.
                 Filled from code — see BuildOutlinePalette. -->
            <Grid x:Name="OutlineColorTray"
                  HorizontalAlignment="Left"
                  Visibility="Collapsed">
                <Border Background="{DynamicResource ToolbarBg}"
                        Margin="2"
                        CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                          Opacity="0.20" Color="#000000"/>
                    </Border.Effect>
                </Border>

                <Border x:Name="OutlineColorTraySurface"
                        Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource ToolbarBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="6"
                        RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel x:Name="OutlineSwatches" Orientation="Horizontal"/>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</Window>
