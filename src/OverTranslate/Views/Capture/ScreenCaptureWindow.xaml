<Window x:Class="OverTranslate.Views.Capture.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:OverTranslate.Views.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SizeBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AppButtonPressedBg}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="On">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AppAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Frozen screenshot as background -->
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>

        <!-- The dim, over everything and never changed. The selection is uncovered by laying the
             same frozen picture back over it (SelectionBright) rather than by cutting a hole in
             this: a hole is a new full-screen shape on every move of the pointer, and WPF then
             repaints the whole desktop for each one — the stutter, at two monitors' worth of
             pixels per frame. Laid back over, only the box's old and new places are repainted. -->
        <Rectangle x:Name="DimLayer" Fill="#80000000"/>

        <!-- Absolute-positioned canvas for selection rect -->
        <Canvas x:Name="OverlayCanvas">
            <!-- The frozen picture again, showing through the dim exactly where the box is. Its
                 brush maps the box onto the same place in the picture, one to one. -->
            <Rectangle x:Name="SelectionBright"
                       Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!-- Covers the box without tinting it: the framed content shows exactly as it is, the
                 blue edge alone marks the box (as Snipaste does). It used to carry a light blue
                 wash, which over the opening whole-screen offer read as the screen changing colour.
                 Kept transparent rather than removed so the box still hit-tests as before. -->
            <Rectangle x:Name="SelectionFill"
                       RadiusX="3"
                       RadiusY="3"
                       Visibility="Collapsed"
                       Fill="Transparent"/>

            <!-- Where the 標記 marks are shown. They belong to the overlay, which owns and draws
                 them; they are hung here because this window is opaque and that one is not. A
                 transparent window is presented by copying all of its content out of video memory
                 and back whenever any of it changes, which for a window the size of the desktop
                 measured 2.38ms each time against 0.035ms here, and was what an eraser dropping
                 frames was made of.

                 Above the tint and below the frame. Under the tint the marks came out washed out on
                 screen while the saved picture — which has no selection furniture in it at all —
                 showed them at full strength, so what the user was aiming with and what they got
                 were two different colours. -->
            <Canvas x:Name="OverlayContentHost" IsHitTestVisible="False"/>

            <!-- A thin dark line just outside the frame, so the edge stays legible over a bright
                 screenshot as well as a dark one. It stands in for the blurred shadow the frame
                 used to carry: an Effect is re-blurred over the whole box on every move, which on a
                 large box was most of a frame's time. -->
            <Rectangle x:Name="SelectionOutline"
                       Stroke="#59000000"
                       StrokeThickness="1"
                       Visibility="Collapsed"/>

            <!-- The frame: one solid edge, drawn the same while dragging and once settled. -->
            <Rectangle x:Name="SelectionRect"
                       Stroke="#E61E90D5"
                       StrokeThickness="2"
                       Visibility="Collapsed"/>

            <!-- Drag the middle to move the whole selection, as on the realtime edit layer. A
                 separate transparent thumb rather than the rectangle itself: the rectangle is also
                 the drawing preview, and it must not start capturing the pointer mid-draw. Declared
                 before the corner handles so those stay on top and keep resize reachable at a
                 corner, where the two overlap. -->
            <Thumb x:Name="SelectionBody"
                   Visibility="Collapsed"
                   Cursor="SizeAll"
                   DragDelta="SelectionBody_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="TopLeftHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNWSE"
                   DragDelta="TopLeftHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="TopRightHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNESW"
                   DragDelta="TopRightHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomLeftHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNESW"
                   DragDelta="BottomLeftHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomRightHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNWSE"
                   DragDelta="BottomRightHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- The size bar over the box's top-left corner, in the app's own toolbar colours: the
                 size first (click to type one) with px / dip beside it, then square or rounded
                 corners, a locked aspect ratio and a fresh screenshot. While the box is being dragged
                 out only the size shows; the rest comes once it is let go. The surface is a little
                 see-through, the buttons on it are not. Scaled in code to the monitor it is on, the
                 way the hint cards are. -->
            <Grid x:Name="SizeBar"
                  Visibility="Collapsed"
                  Cursor="Arrow">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="SizeBarScale"/>
                </Grid.LayoutTransform>
                <Border Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource ToolbarBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Opacity="0.85"/>
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Button x:Name="SizeBtn" Style="{StaticResource SizeBarButton}" Click="SizeBtn_Click"
                            ToolTip="{DynamicResource S.Capture.SizeTip}">
                        <TextBlock x:Name="SizeText" FontFamily="{DynamicResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                    </Button>
                    <StackPanel x:Name="SizeBarTools" Orientation="Horizontal">
                        <!-- px and dip side by side, the one in use filled with the accent. -->
                        <Border Background="{DynamicResource AppInputBg}" CornerRadius="6" Padding="2" Margin="2,0,0,0"
                                VerticalAlignment="Center" ToolTip="{DynamicResource S.Capture.UnitTip}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UnitPxBtn" Style="{StaticResource SizeBarButton}" Click="UnitPx_Click"
                                        MinHeight="22" Padding="7,1">
                                    <TextBlock Text="px" FontSize="11.5"/>
                                </Button>
                                <Button x:Name="UnitDipBtn" Style="{StaticResource SizeBarButton}" Click="UnitDip_Click"
                                        MinHeight="22" Padding="7,1">
                                    <TextBlock Text="dip" FontSize="11.5"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Rectangle Width="1" Margin="4,6" Fill="{DynamicResource AppSeparator}"/>
                        <Button x:Name="CornerBtn" Style="{StaticResource SizeBarButton}" Click="CornerBtn_Click">
                            <Path x:Name="CornerIcon" Width="14" Height="14" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="AspectBtn" Style="{StaticResource SizeBarButton}" Click="AspectBtn_Click">
                            <TextBlock x:Name="AspectIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <Button x:Name="RefreshBtn" Style="{StaticResource SizeBarButton}" Click="RefreshBtn_Click"
                                ToolTip="{DynamicResource S.Capture.RefreshTip}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Canvas>

        <!-- Hint, repeated once per monitor at its bottom-left (see BuildHintSpots): on a
             multi-monitor desktop a single one would sit on whichever screen holds that corner of
             the virtual desktop, which may not be the one the user is looking at. -->
        <ItemsControl x:Name="HintHost">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Bottom" Value="{Binding Bottom}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- No card behind it: the text is laid straight over the frozen desktop, each glyph
                         outlined in dark so it stays legible over bright and dark content alike. Keys
                         are drawn as outlined keycaps in the same two colours. -->
                    <StackPanel Orientation="Horizontal" TextElement.FontFamily="{DynamicResource AppFont}">
                        <!-- This window spans every monitor and so renders at one DPI; without this
                             the hint is undersized on a monitor running at a higher scale. -->
                        <StackPanel.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </StackPanel.LayoutTransform>
                        <StackPanel.Resources>
                            <Style x:Key="HintText" TargetType="ctl:OutlinedText">
                                <Setter Property="Fill" Value="#F2FFFFFF"/>
                                <Setter Property="Stroke" Value="#D9000000"/>
                                <Setter Property="StrokeThickness" Value="1.6"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <!-- Keycap: a white edge with a dark one around it, nothing filled in. -->
                            <Style x:Key="HintKeyOuter" TargetType="Border">
                                <Setter Property="BorderBrush" Value="#A6000000"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="5"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="HintKeyInner" TargetType="Border">
                                <Setter Property="BorderBrush" Value="#E6FFFFFF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </StackPanel.Resources>

                        <!-- Leading position: before a selection exists this is the only clickable
                             way out, so it reads first instead of trailing the copy. E8BB rather than a
                             typed ✕, which in the UI font sits below the button's centre. -->
                        <Button Style="{StaticResource IconButton}"
                                VerticalAlignment="Center"
                                ToolTip="{DynamicResource S.Capture.CancelTip}"
                                Click="CancelCaptureBtn_Click">
                            <ctl:OutlinedText Style="{StaticResource HintText}"
                                              Text="&#xE8BB;"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              FontSize="12"/>
                        </Button>

                        <Border Width="3" Height="40" Margin="8,0,12,0" VerticalAlignment="Center"
                                Background="#E6FFFFFF" BorderBrush="#A6000000" BorderThickness="1"/>

                        <StackPanel VerticalAlignment="Center">
                            <ctl:OutlinedText Style="{StaticResource HintText}"
                                              FontSize="15.5" FontWeight="SemiBold"
                                              HorizontalAlignment="Left"
                                              Text="{DynamicResource S.Capture.DragPrompt}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ctl:OutlinedText Style="{StaticResource HintText}"
                                                  Text="{DynamicResource S.Capture.PressPrefix}"/>
                                <Border Style="{StaticResource HintKeyOuter}" Margin="4,0">
                                    <Border Style="{StaticResource HintKeyInner}">
                                        <ctl:OutlinedText Style="{StaticResource HintText}"
                                                          FontSize="11.5" FontWeight="SemiBold" Text="ESC"/>
                                    </Border>
                                </Border>
                                <ctl:OutlinedText Style="{StaticResource HintText}"
                                                  Text="{DynamicResource S.Capture.CancelSuffix}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Style="{StaticResource HintKeyOuter}" Margin="0,0,4,0">
                                    <Border Style="{StaticResource HintKeyInner}">
                                        <ctl:OutlinedText Style="{StaticResource HintText}"
                                                          FontSize="11.5" FontWeight="SemiBold" Text="F5"/>
                                    </Border>
                                </Border>
                                <ctl:OutlinedText Style="{StaticResource HintText}"
                                                  Text="{DynamicResource S.Capture.RefreshHint}"/>
                                <Border Style="{StaticResource HintKeyOuter}" Margin="12,0,4,0">
                                    <Border Style="{StaticResource HintKeyInner}">
                                        <ctl:OutlinedText Style="{StaticResource HintText}"
                                                          FontSize="11.5" FontWeight="SemiBold" Text="Ctrl+A"/>
                                    </Border>
                                </Border>
                                <ctl:OutlinedText Style="{StaticResource HintText}"
                                                  Text="{DynamicResource S.Capture.SelectAllHint}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
